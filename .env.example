# true = use the built-in mock API (no backend needed)
VITE_USE_MOCKS=false
# Backend base URL, used when VITE_USE_MOCKS=false.
# Keep it same-origin (/api/v1): Vite forwards /api to the API on port 4000 in development,
# and nginx does the same in production (see shieldops-api/deploy/nginx.conf).
VITE_API_URL=/api/v1
# Where apps send SDK telemetry. Defaults to <this site>/ingest/v1
# VITE_INGEST_URL=https://ingest.example.com/v1